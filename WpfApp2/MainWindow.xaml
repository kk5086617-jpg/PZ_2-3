<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row=" 0" Background="Khaki" >
            <Image Width="60" Height="60" HorizontalAlignment="Left" Source="https://alliance.tc/wa-data/public/shop/themes/default/img/I70uWUxAoSA.jpg"/>
            <Button x:Name="Exit" HorizontalAlignment="Right" Content="Выход" Click="Exit_Click"/>

        </Grid>
        <Button Content="Задание 1" HorizontalAlignment="Left" Margin="10,0,0,0" Grid.Row="1" VerticalAlignment="Center" Height="60" Width="80" Background="Honeydew" Click="Button_Click"/>
        <Button Content="Задание 2" HorizontalAlignment="Left" Margin="181,0,0,0" Grid.Row="1" VerticalAlignment="Center" Height="60" Width="80" Background="Honeydew" Click="Button_Click_1"/>
        <Button Content="Задание 3" HorizontalAlignment="Center" Grid.Row="1" VerticalAlignment="Center" Height="60" Width="80" Background="Honeydew" Click="Button_Click_2"/>
        <Button Content="Задание 4" HorizontalAlignment="Left" Margin="544,0,0,0" Grid.Row="1" VerticalAlignment="Center" Height="60" Width="80" RenderTransformOrigin="1.014,0.685" Background="Honeydew" Click="Button_Click_3"/>
        <Button Content="Задание 5" HorizontalAlignment="Left" Margin="710,0,0,0" Grid.Row="1" VerticalAlignment="Center" Height="60" Width="80" Background="Honeydew" Click="Button_Click_4" />
        <Button x:Name="Coc" Content="" HorizontalAlignment="Left" Margin="778,350,0,0" Grid.Row="1" VerticalAlignment="Top" Height="14" Width="12" Click="Coc_Click"/>
        <Image x:Name="cat" HorizontalAlignment="Left" Height="144" Margin="613,222,0,0" Grid.Row="1" VerticalAlignment="Top" Width="140" Source="/Снимок экрана 2025-10-07 190051.png" Visibility="Hidden"/>

    </Grid>
</Window>

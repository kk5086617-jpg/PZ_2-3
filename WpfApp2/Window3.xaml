<Window x:Class="WpfApp2.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="Window3" Height="450" Width="800">
    <Grid Background="Honeydew">
        <Grid.RowDefinitions>
            <RowDefinition Height="38*"/>
            <RowDefinition Height="179*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#38220F">
            <Image Width="60" Height="60" HorizontalAlignment="Left" Source="https://alliance.tc/wa-data/public/shop/themes/default/img/I70uWUxAoSA.jpg"/>
            <Button x:Name="Exit" Width="70" Background="#ECE0D1" Foreground="#38220F" FontWeight="Bold" HorizontalAlignment="Right" Content="Выход" Click="Exit_Click"/>
            <Label Content="Задание 3" HorizontalAlignment="Center" FontWeight="Bold" VerticalAlignment="Center" FontSize="20" Background="#FFECE0D1"/>
        </Grid>
        <TextBox x:Name="TextBox3" HorizontalAlignment="Center" Margin="0,27,0,0" Grid.Row="1" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" BorderBrush="#FF38220F"/>
        <Label Content="Введите массив" HorizontalAlignment="Center" Margin="0,50,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <ListBox x:Name="ListBox3" HorizontalAlignment="Left" Height="104" Margin="316,81,0,0" Grid.Row="1" VerticalAlignment="Top" Width="183" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <Button Content=" " HorizontalAlignment="Left" Margin="460,26,0,0" Grid.Row="1" VerticalAlignment="Top" Width="20" Click="Button_Click"/>

    </Grid>
</Window>
